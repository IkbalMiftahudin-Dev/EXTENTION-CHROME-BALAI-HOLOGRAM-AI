{
  "manifest_version": 3,
  "name": "BALAI — Holographic AI Assistant",
  "short_name": "BALAI",
  "version": "1.0.0",
  "description": "Asisten AI Holografik 3D berbentuk manusia (BALAI) dengan suara Bahasa Indonesia, manajemen jadwal & tugas yang sinkron lintas perangkat.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Buka BALAI Hologram AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "app.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ]
}

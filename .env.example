# Konfigurasi BALAI Holographic AI Assistant
# Salin file ini menjadi .env lalu isi GEMINI_API_KEY Anda.
# Dapatkan API Key gratis di: https://aistudio.google.com/apikey

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hologram_ai
DB_USER=root
DB_PASS=

APP_TIMEZONE=Asia/Jakarta
